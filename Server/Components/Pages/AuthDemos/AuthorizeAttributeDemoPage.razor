@page "/auth-demos/authorize-attribute"
@using Microsoft.AspNetCore.Authorization
 
@attribute [Authorize]
 
<h1>Page Authentication Demo</h1>
 
<p>
    This page demonstrates how to use the <code>&#64;attribute [Authorize]</code> directive to protect a page. Only
    authenticated users will be able to access this page. If you are not authenticated, you will be redirected to
    the login page.
</p>