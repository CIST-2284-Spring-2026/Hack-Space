@page "/auth-demos/authorize-component"
 
<h1>Authorize Component Demo</h1>
 
<AuthorizeView>
    <Authorized>
        <p>You are authorized to see this content.</p>
    </Authorized>
    <NotAuthorized>
        <p>You are not authorized to see this content. Please log in to access it.</p>
    </NotAuthorized>
</AuthorizeView>